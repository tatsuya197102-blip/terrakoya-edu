rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザー自身のデータ
    match /users/{userId} {
      // 本人のみ自分のドキュメント読み取り可
      allow read: if request.auth != null && request.auth.uid == userId;

      // 作成時: role は null (自己昇格防止)
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.get('role', null) == null;

      // 更新時: role 変更なし OR student/other 自己昇格 OR 招待コード経由
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && (
                      request.resource.data.get('role', null) == resource.data.get('role', null)
                      || (request.resource.data.get('role', null) in ['student', 'other']
                          && resource.data.get('role', null) == null)
                      || (request.resource.data.get('role', null) in ['teacher', 'parent']
                          && request.resource.data.get('inviteCodeUsed', '') is string
                          && request.resource.data.get('inviteCodeUsed', '') != '')
                    );

      // 削除禁止 (admin SDK のみ)
      allow delete: if false;

      // 提出物サブコレクション (既存維持)
      match /submissions/{submissionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // === 招待コード (teacher/parent 認証用) ===
    match /invite_codes/{code} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.usedBy == null
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.role == resource.data.role
                    && resource.data.expiresAt > request.time.toMillis();
      allow create, delete: if false;
    }

    // コース（全ログインユーザーが読める、書き込みは管理者のみ）
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'tatsuya197102@gmail.com';
    }

    // レッスン（全ログインユーザーが読める）
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'tatsuya197102@gmail.com';
    }

    // 通知（自分の通知のみ読める）
    match /notifications/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.token.email == 'tatsuya197102@gmail.com';
    }

    // ライブ授業（全ログインユーザーが読める）
    match /liveLessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'tatsuya197102@gmail.com';
    }

    // コンテスト（全ログインユーザーが読める、自分のエントリーは書ける）
    match /contestEntries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
    match /contest_entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // 学校情報（全ログインユーザーが読める）
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'tatsuya197102@gmail.com';
    }

    // ショーケース（全ログインユーザーが読める）
    match /showcase/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // 作品（ギャラリー）: トップレベル submissions
    // 読み取り: 公開作品 or 自分の作品 / 作成: 本人の作品のみ
    // 更新: 本人は編集可、他人は likes / reactions / comments のみ変更可（いいね・応援スタンプ・定型コメント）
    // 削除: 本人のみ
    match /submissions/{submissionId} {
      allow read: if request.auth != null
                  && (resource.data.get('isPublic', false) == true
                      || resource.data.get('studentId', '') == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.get('studentId', '') == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      resource.data.get('studentId', '') == request.auth.uid
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'comments'])
                    );
      allow delete: if request.auth != null
                    && resource.data.get('studentId', '') == request.auth.uid;
    }
  }
}
